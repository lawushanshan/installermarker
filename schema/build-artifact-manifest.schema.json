{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:build-artifact-manifest:1",
  "title": "InstallerMarker source-build artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "build", "provenance", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "command", "platform"],
      "properties": {
        "strategy": { "enum": ["electron", "tauri", "go-native", "rust-native", "python-native"] },
        "command": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "finishedAt", "durationMs", "runner"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeVersion", "platform", "arch"],
          "properties": {
            "nodeVersion": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "arch": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents"],
      "properties": {
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "format", "size", "sha256", "sourcePath"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
              "format": { "enum": ["cyclonedx", "spdx", "unknown"] },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "sourcePath": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "name", "size", "sha256", "sourcePath"],
        "properties": {
          "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
          "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourcePath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
