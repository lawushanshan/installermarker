{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:recipe:1",
  "title": "InstallerMarker recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "application", "build", "targets", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entrypoint"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "command"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "suggestedPackager": { "type": "string", "minLength": 1 },
        "suggestedCommand": { "type": "string", "minLength": 1 },
        "artifactDirectories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "status", "packaging"],
        "properties": {
          "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
          "status": { "enum": ["available", "likely", "needs_review"] },
          "packaging": { "enum": ["reuse-installer", "wrap-release-asset", "build-electron", "build-tauri", "build-native", "TODO: select packager"] },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url", "size", "digest"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
              "url": { "type": "string", "format": "uri" },
              "size": { "type": "integer", "minimum": 1 },
              "digest": {
                "oneOf": [
                  { "type": "null" },
                  { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "packaging": { "const": "reuse-installer" } }, "required": ["packaging"] },
            "then": {
              "required": ["input"],
              "properties": {
                "input": {},
                "status": { "const": "available" }
              }
            }
          }
        ]
      }
    },
    "review": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}