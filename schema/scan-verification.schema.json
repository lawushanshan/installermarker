{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:scan-verification:1",
  "title": "InstallerMarker scan result verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "valid", "source", "manifest", "artifactCount", "scanner", "summary", "checks", "errors", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "valid": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": { "enum": ["artifacts.json", "build-artifacts.json"] },
    "artifactCount": { "type": "integer", "minimum": 1 },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "passed", "failed", "inconclusive"],
      "properties": {
        "verdict": { "enum": ["passed", "failed", "inconclusive"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": { "enum": ["error"] },
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
