{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:smoke-result:1",
  "title": "InstallerMarker isolated smoke test result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "runner", "source", "manifest", "execution", "results", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["artifacts.json", "build-artifacts.json"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "boundary"],
      "properties": {
        "mode": { "const": "external-isolated-smoke-runner" },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "installerType", "runOn", "verdict", "steps"],
        "properties": {
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "name", "size", "sha256"],
            "properties": {
              "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
              "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "installerType": { "enum": ["msi", "exe", "dmg", "pkg", "appimage", "deb", "rpm"] },
          "runOn": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
          "verdict": { "enum": ["passed", "failed", "inconclusive"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "status": { "enum": ["passed", "failed", "inconclusive"] },
                "summary": { "type": "string" }
              }
            }
          },
          "runnerReference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "passed", "failed", "inconclusive"],
      "properties": {
        "verdict": { "enum": ["passed", "failed", "inconclusive"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
