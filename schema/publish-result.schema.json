{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:publish-result:1",
  "title": "InstallerMarker protected publisher result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "publisher", "source", "manifest", "release", "execution", "assets", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["artifacts.json", "build-artifacts.json"] }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "url", "draft"],
      "properties": {
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/tag/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "draft": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "boundary"],
      "properties": {
        "mode": { "const": "external-protected-release-service" },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "sha256", "verdict"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
          "type": { "enum": ["installer", "artifact-manifest", "release-verification", "build-sbom"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "verdict": { "enum": ["passed", "failed", "inconclusive"] },
          "url": { "type": "string", "pattern": "^https://" },
          "summary": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "passed", "failed", "inconclusive"],
      "properties": {
        "verdict": { "enum": ["passed", "failed", "inconclusive"] },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
