{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:publish-plan:1",
  "title": "InstallerMarker publish plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "manifest", "execution", "release", "evidence", "assets", "supplementalAssets", "checklist"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["artifacts.json", "build-artifacts.json"] },
        "build": { "type": "object" },
        "provenance": { "type": "object" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "safety"],
      "properties": {
        "mode": { "const": "plan-only" },
        "safety": { "type": "string", "minLength": 1 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "title", "draft"],
      "properties": {
        "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "title": { "type": "string", "minLength": 1 },
        "draft": { "const": true }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseVerificationValid", "gateCount", "releaseVerificationGeneratedAt"],
      "properties": {
        "releaseVerificationValid": { "const": true },
        "gateCount": { "type": "integer", "minimum": 5 },
        "releaseVerificationGeneratedAt": { "type": "string", "format": "date-time" }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "publishAs", "requiredSha256"],
        "properties": {
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "name", "size", "sha256"],
            "properties": {
              "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
              "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "publishAs": { "type": "string", "pattern": "^[^\\\\/]+$" },
          "requiredSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "supplementalAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
          "type": { "enum": ["artifact-manifest", "release-verification", "build-sbom"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
