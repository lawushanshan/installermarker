{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:installermarker:signing-plan:1",
  "title": "InstallerMarker signing plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "source", "manifest", "execution", "requests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "enum": ["artifacts.json", "build-artifacts.json"] },
        "build": { "type": "object" },
        "provenance": { "type": "object" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "safety"],
      "properties": {
        "mode": { "const": "plan-only" },
        "safety": { "type": "string", "minLength": 1 }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "profile", "stages", "credentialBoundary"],
        "properties": {
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "name", "size", "sha256"],
            "properties": {
              "platform": { "enum": ["windows-x64", "macos-universal", "linux-x64"] },
              "name": { "type": "string", "pattern": "^[^\\\\/]+$" },
              "size": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "profile": { "enum": ["windows-authenticode", "macos-developer-id", "linux-detached-signature"] },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "credentialBoundary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
